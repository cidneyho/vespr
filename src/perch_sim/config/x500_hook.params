# PX4 settings for the sim hook drone (gz_x500_hook): every parameter the sim changes from PX4's
# X500 (airframe 4001), with why. The real drone's PX4 settings are kept separately.
#
# Read by PX4's shell: airframes/4920_gz_x500_hook sources this file after the X500 airframe, so
# these defaults win. run_sim.sh passes its path in PERCH_PX4_PARAMS, and the options below in
# PX4_GPS (GPS=1) and PX4_EV (EV=mocap or EV=vio). They aren't saved between runs (run_sim.sh
# clears saved parameters), so changing an option needs no cleanup.
#
# Format: plain PX4 shell. `param set-default NAME VALUE`, one per line, with a comment above.

# ---- Position source ----
#
#   (default)  optical flow + rangefinder + compass, GPS off: indoors without mocap or VIO
#   GPS=1      GPS on as well, as outdoors
#   EV=mocap   flies on mocap through external_bridge, flow off (stages 1 and 2)
#   EV=vio     flies on VIO through external_bridge, flow on as a helper (stage 3)
# EV must match external_bridge's source (docs/design/external_bridge.md).

if [ "$PX4_GPS" = 1 ]
then
	echo "x500_hook: GPS on"
else
	echo "x500_hook: GPS off"
	param set-default SYS_HAS_GPS 0
	param set-default SIM_GPS_USED 0
	param set-default EKF2_GPS_CTRL 0
fi

if [ "$PX4_EV" = mocap ] || [ "$PX4_EV" = vio ]
then
	echo "x500_hook: flying on external_bridge ($PX4_EV)"
	# Fuse the bridge's horizontal and vertical position (1 + 2), velocity (4) and heading (8).
	# Mocap sends no velocity, so for it the 4 does nothing
	param set-default EKF2_EV_CTRL 15
	# Height from the bridge, not the rangefinder. The rangefinder stays on: Commander reads
	# dist_bottom from it
	param set-default EKF2_HGT_REF 3
	# Heading from the bridge: x is the drone's starting heading, not north. The compass would
	# fight it
	param set-default EKF2_MAG_TYPE 5
	# Stamps are the time each sample was measured, already on PX4's clock
	param set-default EKF2_EV_DELAY 0
	# Mocap and VIO both report base_link, the body centre: no offset (m)
	param set-default EKF2_EV_POS_X 0
	param set-default EKF2_EV_POS_Y 0
	param set-default EKF2_EV_POS_Z 0
	if [ "$PX4_EV" = mocap ]
	then
		# Flow off: a steady hover then proves the bridge is doing the work
		param set-default EKF2_OF_CTRL 0
		# How far PX4 trusts mocap (m, rad). PX4 never trusts a sample more than these, whatever
		# the message says, and its defaults (0.1 m, 0.1 rad) would treat mocap as 10 cm
		# accurate. The bridge sends mocap without variances, so these are mocap's.
		# Starting values (2026-11-15): tune in the hover test
		param set-default EKF2_EVP_NOISE 0.01
		param set-default EKF2_EVA_NOISE 0.02
	fi
	# EV=vio: flow stays on (PX4's default) and the noise floors stay at PX4's 0.1 m and 0.1 rad.
	# VIO sends its own variances in the message
elif [ -n "$PX4_EV" ]
then
	echo "x500_hook: unknown EV=$PX4_EV (mocap or vio); flying on flow"
else
	echo "x500_hook: flying on optical flow and rangefinder"
fi

# ---- Ground station ----

# Fly without a ground station
param set-default NAV_DLL_ACT 0

# ---- Sensors ----

# Where the flow sensor and rangefinder are, from the drone's centre (m, forward-right-down).
# Must match config/x500_hook.yaml (flow x 0.03 z -0.052, rangefinder z -0.057, z up there)
param set-default EKF2_OF_POS_X 0.03
param set-default EKF2_OF_POS_Z 0.052
param set-default EKF2_RNG_POS_Z 0.057
# What the rangefinder reads with the drone on the ground (m): 0.17 measured in the sim
param set-default EKF2_MIN_RNG 0.17
# How late flow readings arrive (ms). The sim's flow sensor has no processing delay: with PX4's
# default 20 ms, its readings lined up best with the true motion 28 ms later (2026-11-05)
param set-default EKF2_OF_DELAY 0
# The sim's magnetic declination (deg), measured from its magnetometer against Gazebo's true
# attitude (2026-11-05). Without GPS, PX4 can't look it up and uses 0, which turns the heading by
# this much. Gazebo's sign is the opposite of the real one at the world's location (+3.4)
param set-default EKF2_MAG_DECL -2.6

# ---- Hover ----

# The hook and camera make it heavier than the plain x500: measured hover thrust 0.76 (PX4's
# own estimate in flight). Fixed, not learned: hanging from the branch in land mode, PX4 doesn't
# know it has landed and learns the lower thrust the branch needs, about 0.5. Taking off from
# the branch then starts far below hover and can't lift off the hook
param set-default MPC_THR_HOVER 0.76
param set-default MPC_USE_HTE 0
