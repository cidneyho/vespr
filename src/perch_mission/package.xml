<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>perch_mission</name>
  <version>0.0.0</version>
  <description>VESPR mission: the mission node, the perch cycle and its flight path planners (docs/design/mission.md, planning.md)</description>
  <maintainer email="placeholder@gmail.com">Dom Taing</maintainer>
  <license>TODO</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>perch_interfaces</exec_depend>
  <exec_depend>px4_msgs</exec_depend>
  <!-- The flight Commander -->
  <exec_depend>perch_flight</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
