{
  "name": "vespr",
  "dockerFile": "Dockerfile",
  "runArgs": [
    "--privileged",
    "--network=host",
    "--gpus", "all",
    "--shm-size=2g",
    "-e", "DISPLAY=${localEnv:DISPLAY}",
    "-e", "NVIDIA_DRIVER_CAPABILITIES=all"
  ],
  "workspaceMount": "source=${localWorkspaceFolder},target=/home/ubuntu/vespr,type=bind",
  "workspaceFolder": "/home/ubuntu/vespr",
  "mounts": [
    "source=/etc/timezone,target=/etc/timezone,type=bind",
    "source=/etc/localtime,target=/etc/localtime,type=bind",
    "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind",
    "source=/dev,target=/dev,type=bind",
    "source=/etc/udev,target=/etc/udev,type=bind"
  ],
  "postCreateCommand": "bash -lc 'source ~/px4_ws/install/setup.bash && sudo apt-get update && rosdep install --from-paths src -yi --skip-keys px4_msgs && colcon build --symlink-install'",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ]
    }
  }
}
