#!/bin/sh
#
# @name Gazebo x500 with the VESPR perching hook
#
# @type Quadrotor
#
# The X500 with our hook, a RealSense stand-in, and downward optical flow and rangefinder
# (models/x500_hook). Indoor by default: flies on flow + rangefinder with GPS off, like PX4's
# 4021_gz_x500_flow.
#
# Every setting we change from the X500 is in config/x500_hook.params, with why, including the
# GPS=1 and EV=mocap|vio options. run_sim.sh links this file into PX4's airframes and passes that
# file's path in PERCH_PX4_PARAMS.

PX4_SIM_MODEL=${PX4_SIM_MODEL:=x500_hook}

. ${R}etc/init.d-posix/airframes/4001_gz_x500

if [ -f "$PERCH_PX4_PARAMS" ]
then
	. "$PERCH_PX4_PARAMS"
else
	echo "ERROR x500_hook: no settings file (PERCH_PX4_PARAMS='$PERCH_PX4_PARAMS'). Start it with run_sim.sh"
fi
