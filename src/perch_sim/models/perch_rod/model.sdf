<?xml version="1.0"?>
<!--
  Horizontal rod on two posts, standing in for a branch.
  Rod: 4 cm diameter, 1.5 m long, along the model's y axis, top of rod at 1.52 m.
  Static, so it never moves when the drone hits it.
  perch_point: where to perch, on the rod's centreline at its middle. x along the rod, z up.
-->

<sdf version="1.9">
  <model name="perch_rod">
    <static>true</static>

    <link name="rod">
      <pose>0 0 1.5 1.5708 0 0</pose>
      <collision name="collision">
        <geometry>
          <cylinder><radius>0.02</radius><length>1.5</length></cylinder>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder><radius>0.02</radius><length>1.5</length></cylinder>
        </geometry>
        <material>
          <ambient>0.4 0.25 0.1 1</ambient>
          <diffuse>0.4 0.25 0.1 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- No collision or visual: a marker that Gazebo reports the pose of (perch_sim mocap_sim) -->
    <link name="perch_point">
      <pose>0 0 1.5 0 0 1.5708</pose>
    </link>

    <link name="post_left">
      <pose>0 0.8 0.75 0 0 0</pose>
      <collision name="collision">
        <geometry><box><size>0.05 0.05 1.5</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.05 0.05 1.5</size></box></geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="post_right">
      <pose>0 -0.8 0.75 0 0 0</pose>
      <collision name="collision">
        <geometry><box><size>0.05 0.05 1.5</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.05 0.05 1.5</size></box></geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
